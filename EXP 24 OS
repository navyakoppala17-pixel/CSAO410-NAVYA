#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;
    char buffer[100];

    fd=open("sample.txt",O_CREAT|O_RDWR,0644);

    if(fd<0)
    {
        printf("File open failed\n");
        return 1;
    }

    write(fd,"Operating Systems Lab",21);

    lseek(fd,0,SEEK_SET);

    read(fd,buffer,21);

    buffer[21]='\0';

    printf("File Content: %s\n",buffer);

    close(fd);

    return 0;
}
