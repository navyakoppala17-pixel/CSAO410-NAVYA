#include <stdio.h>

int main() {
    int users, files;

    printf("Users: ");
    scanf("%d",&users);

    for(int i=0;i<users;i++) {
        printf("\nUser %d\n",i+1);

        printf("Files: ");
        scanf("%d",&files);

        char file[20];

        for(int j=0;j<files;j++) {
            printf("File %d: ",j+1);
            scanf("%s",file);
        }
    }

    return 0;
}
