#include <stdio.h>

int main() {
    int n;
    char files[20][20];

    printf("Number of files: ");
    scanf("%d",&n);

    for(int i=0;i<n;i++) {
        printf("Enter file %d: ",i+1);
        scanf("%s",files[i]);
    }

    printf("\nFiles:\n");

    for(int i=0;i<n;i++)
        printf("%s\n",files[i]);

    return 0;
}
