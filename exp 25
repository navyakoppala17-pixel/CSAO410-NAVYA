// Q25: UNIX I/O System Calls
#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main()
{
    int fd;
    char buffer[100];
    struct stat st;
    DIR *dir;
    struct dirent *entry;

    // Open file using open()
    fd = open("sample.txt", O_RDWR | O_CREAT, 0644);

    if (fd < 0)
    {
        perror("open");
        return 1;
    }

    printf("File opened successfully.\n");

    // fcntl()
    printf("File descriptor flags: %d\n", fcntl(fd, F_GETFL));

    // Write to file
    write(fd, "Hello UNIX\n", 11);

    // lseek() - move file pointer to beginning
    lseek(fd, 0, SEEK_SET);

    // Read file
    int n = read(fd, buffer, sizeof(buffer) - 1);
    buffer[n] = '\0';

    printf("File contents: %s", buffer);

    // stat()
    if (stat("sample.txt", &st) == 0)
    {
        printf("\nFile size: %ld bytes\n", st.st_size);
        printf("File permissions: %o\n", st.st_mode & 0777);
    }

    close(fd);

    // opendir()
    dir = opendir(".");

    if (dir == NULL)
    {
        perror("opendir");
        return 1;
    }

    printf("\nDirectory contents:\n");

    // readdir()
    while ((entry = readdir(dir)) != NULL)
    {
        printf("%s\n", entry->d_name);
    }

    closedir(dir);

    return 0;
}
