#include <stdio.h>

int main()
{
    int nb,np;

    scanf("%d",&nb);

    int block[20];

    for(int i=0;i<nb;i++)
        scanf("%d",&block[i]);

    scanf("%d",&np);

    int process[20];

    for(int i=0;i<np;i++)
        scanf("%d",&process[i]);

    for(int i=0;i<np;i++)
    {
        int best=-1;

        for(int j=0;j<nb;j++)
        {
            if(block[j]>=process[i])
            {
                if(best==-1||block[j]<block[best])
                    best=j;
            }
        }

        if(best!=-1)
        {
            printf("Process %d -> Block %d\n",i+1,best+1);
            block[best]-=process[i];
        }
        else
            printf("Process %d Not Allocated\n",i+1);
    }
}
