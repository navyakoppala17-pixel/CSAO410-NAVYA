#include <stdio.h>
#include <stdlib.h>

void sort(int a[], int n)
{
    int i, j, temp;

    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (a[i] > a[j])
            {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }
        }
    }
}

int main()
{
    int request[50];
    int n, head, diskSize;
    int direction;
    int i;
    int totalMovement = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &diskSize);

    printf("Enter direction (1 = right, 0 = left): ");
    scanf("%d", &direction);

    sort(request, n);

    printf("\nSeek Sequence:\n");
    printf("%d", head);

    if (direction == 1)
    {
        // Move towards right
        for (i = 0; i < n; i++)
        {
            if (request[i] >= head)
            {
                totalMovement += abs(head - request[i]);
                head = request[i];

                printf(" -> %d", head);
            }
        }

        // Go to end of disk
        totalMovement += abs(head - (diskSize - 1));
        head = diskSize - 1;

        printf(" -> %d", head);

        // Reverse direction
        for (i = n - 1; i >= 0; i--)
        {
            if (request[i] < head)
            {
                totalMovement += abs(head - request[i]);
                head = request[i];

                printf(" -> %d", head);
            }
        }
    }
    else
    {
        // Move towards left
        for (i = n - 1; i >= 0; i--)
        {
            if (request[i] <= head)
            {
                totalMovement += abs(head - request[i]);
                head = request[i];

                printf(" -> %d", head);
            }
        }

        // Go to beginning of disk
        totalMovement += abs(head - 0);
        head = 0;

        printf(" -> %d", head);

        // Reverse direction
        for (i = 0; i < n; i++)
        {
            if (request[i] > head)
            {
                totalMovement += abs(head - request[i]);
                head = request[i];

                printf(" -> %d", head);
            }
        }
    }

    printf("\n\nTotal Head Movement = %d\n", totalMovement);

    return 0;
}
